# URL da API (apps/api) — usado pelo http client e pelos links de OAuth.
VITE_API_URL="http://localhost:8080"

# Conteúdo do <meta name="robots"> injetado no index.html. Só o build de
# produção deve usar "index, follow" — todo o resto fica "noindex, nofollow".
VITE_ROBOTS_CONTENT="noindex, nofollow"

# Analytics de produção (valores públicos, embutidos no bundle do Vite).
VITE_UMAMI_WEBSITE_ID=""
VITE_UMAMI_SCRIPT_URL="https://analytics.wallacedev.com.br/script.js"
